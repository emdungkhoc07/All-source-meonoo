# Discord Webhook API URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Địa chỉ Backend Server của Web Mèo Nổ (Render.com hoặc Localhost)
GAME_SERVER_URL=https://explodingkitten-sever.onrender.com

# Link dẫn người chơi vào Web Mèo Nổ
GAME_WEB_URL=http://meono.vercel.app/home.html

# Tag Role thông báo trong Discord (Ví dụ: @exp hoặc <@&ROLE_ID>)
DISCORD_ROLE_TAG=@exp

# Tùy chỉnh tên và avatar Webhook (để trống sẽ dùng mặc định của Webhook bạn tạo trên Discord)
# BOT_NAME=Thư kí tối cao
# BOT_AVATAR=
